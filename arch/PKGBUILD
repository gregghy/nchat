# Maintainer: gregghy

# Builds nchat from this fork's `custom` branch.
# Expects this repo cloned at ~/progetti/nchat (distro-bootstrap does that).
# Usage: cd ~/progetti/nchat/arch && makepkg -si

_pkgname="nchat"
pkgname="$_pkgname-git"
pkgver=5.19.18.r31.gdcac307
pkgrel=1
pkgdesc="console-based chat client with support for Telegram (gregghy fork)"
url="https://github.com/gregghy/nchat"
license=('MIT')
arch=('x86_64')

depends=(
  'file'
  'libwebp'
  'ncurses'
  'openssl'
  'python'
  'sqlite'
  'zlib'
)

makedepends=(
  'cmake'
  'git'
  'go'
  'gperf'
  'ninja'
)

provides=("$_pkgname")
conflicts=("$_pkgname")

_pkgsrc="$_pkgname"
source=("$_pkgsrc"::"git+file:///home/gregghy/progetti/nchat")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 \
    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  export GOFLAGS+=' -buildvcs=false'

  local _cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX='/usr'
    -DCMAKE_INSTALL_LIBEXECDIR="lib/$_pkgname"
    -DCMAKE_INSTALL_MANDIR='share/man'
    -DHAS_SIGNAL=ON
    -Wno-dev
  )

  cmake "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
